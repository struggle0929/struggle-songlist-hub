PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AUTH_SECRET=

# Development-only sample catalog. Never enables demo mode in production.
LOCAL_DEMO=false

# Shared root domain. Broadcaster entry: https://<slug>.xs0929.cn
PUBLIC_ROOT_DOMAIN=xs0929.cn

# Platform branding defaults (not secrets). Each broadcaster overrides page settings.
PUBLIC_SITE_TITLE=主播歌单
PUBLIC_SITE_SUBTITLE=主播歌单与愿望单管理
PUBLIC_SITE_DESCRIPTION=公开歌单、搜索筛选与愿望单提交。
PUBLIC_SITE_TAGLINE=直播查歌、收歌、管歌，一站完成。
PUBLIC_SITE_ICON=

# Optional custom cursors. All five URLs are required when enabled.
PUBLIC_CUSTOM_CURSORS=false
PUBLIC_CURSOR_DEFAULT=
PUBLIC_CURSOR_POINTER=
PUBLIC_CURSOR_TEXT=
PUBLIC_CURSOR_DISABLED=
PUBLIC_CURSOR_PROGRESS=
